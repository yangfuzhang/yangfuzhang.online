---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在">
  <section class="flex flex-1 flex-col items-start justify-center gap-6 py-16">
    <p class="border-[3px] border-ink bg-vermillion px-2 py-1 font-mono text-xs tracking-[0.28em] text-cream uppercase">
      Error 404
    </p>
    <h1 class="font-headline text-[clamp(4rem,16vw,9rem)] leading-[0.85]">走错片场</h1>
    <p class="max-w-md text-lg text-muted-foreground">这个地址没有对应页面。回到印刷车间门口再进一次。</p>
    <a
      href="/"
      class="border-[3px] border-ink bg-lime px-5 py-3 font-poster text-lg brutal-shadow brutal-press"
    >
      返回首页
    </a>
  </section>
</BaseLayout>
