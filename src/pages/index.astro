---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    logo: "/colorblend.svg",
    name: "ColorBlend",
    description: "colorblend.app",
    href: "https://colorblend.app",
    tone: "cream",
  },
  {
    logo: "/pixelartimage.svg",
    name: "图片转像素画",
    description: "pixelartimage.com",
    href: "https://pixelartimage.com",
    tone: "lime",
  },
  {
    logo: "/fullsvgicons.svg",
    name: "Full SVG Icons",
    description: "fullsvgicons.com",
    href: "https://fullsvgicons.com",
    tone: "cream",
  },
  {
    logo: "/emojinav.svg",
    name: "Emoji Nav",
    description: "emojinav.com",
    href: "https://emojinav.com",
    tone: "vermillion",
  },
  {
    logo: "/wheelclick.svg",
    name: "Wheel Click",
    description: "wheelclick.com",
    href: "https://wheelclick.com",
    tone: "ink",
  },
  {
    logo: "/easyremove.svg",
    name: "EasyRemove",
    description: "easyremove.app",
    href: "https://easyremove.app",
    tone: "lime",
  },
];

const tones: Record<string, string> = {
  lime: "bg-lime text-ink",
  cream: "bg-cream text-ink",
  vermillion: "bg-vermillion text-cream",
  ink: "bg-ink text-lime",
};
---

<BaseLayout title="代码笔记">
  <section class="relative flex flex-1 flex-col gap-14 pb-8 md:gap-20">
    <div class="relative">
      <p
        class="rise mb-4 inline-block border-[3px] border-ink bg-cream px-2 py-1 font-mono text-[11px] tracking-[0.28em] uppercase"
        style="animation-delay: 80ms"
      >
        Indie Maker / Full-stack
      </p>

      <div class="relative max-w-[46rem]">
        <h1
          class="rise font-headline text-[clamp(3.2rem,9vw,7.2rem)] leading-[0.92] tracking-tight"
          style="animation-delay: 140ms"
        >
          全栈开发
          <br />
          做出能上线
          <br />
          的小产品
        </h1>

        <span
          class="stamp absolute -right-2 top-8 border-[3px] border-ink bg-vermillion px-3 py-2 font-display text-xs font-extrabold tracking-widest text-cream uppercase md:-right-8 md:top-4 md:text-sm"
        >
          LIVE
        </span>
      </div>

      <p
        class="rise mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground md:text-xl"
        style="animation-delay: 220ms"
      >
        专注 React、Next.js。公众号
        <span class="bg-lime px-1 font-medium text-ink">独立开发老杨</span>
        ，把工具做成可以打开的网站。
      </p>

      <div class="rise mt-8 flex flex-wrap items-center gap-3" style="animation-delay: 300ms">
        <span
          class="border-[3px] border-ink bg-vermillion px-5 py-3 font-poster text-lg text-cream brutal-shadow"
        >
          关注公众号「独立开发老杨」
        </span>
        <a
          href="https://github.com/yangfuzhang"
          target="_blank"
          class="grid h-12 w-12 place-items-center border-[3px] border-ink bg-cream brutal-shadow brutal-press"
          aria-label="GitHub"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </a>
        <a
          href="#"
          class="grid h-12 w-12 place-items-center border-[3px] border-ink bg-cream brutal-shadow brutal-press"
          aria-label="Twitter"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <section id="projects" class="scroll-mt-8">
      <div class="rise mb-5 flex items-end justify-between gap-4" style="animation-delay: 360ms">
        <h2 class="font-poster text-3xl md:text-4xl">我的项目</h2>
        <span class="font-mono text-xs tracking-[0.2em] uppercase">06 SHIPPED</span>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project, index) => (
            <a
              href={project.href}
              target="_blank"
              rel="noreferrer"
              class:list={[
                "brutal-shadow brutal-press group flex min-h-[168px] flex-col justify-between border-[3px] border-ink p-4",
                tones[project.tone],
                index === 0 && "sm:col-span-2",
                "rise",
              ]}
              style={`animation-delay: ${400 + index * 70}ms`}
            >
              <div class="flex items-start justify-between gap-3">
                <span class="border-[3px] border-ink bg-cream p-1">
                  <Image src={project.logo} alt={project.name} width="48" height="48" />
                </span>
                <span class="font-mono text-xs tracking-widest">
                  {String(index + 1).padStart(2, "0")}
                </span>
              </div>
              <div>
                <h3 class="font-poster text-2xl leading-none">{project.name}</h3>
                <p class="mt-2 font-mono text-xs tracking-wide uppercase opacity-80">
                  {project.description} ↗
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <footer class="rise mt-auto border-[3px] border-ink bg-ink text-lime" style="animation-delay: 820ms">
      <div class="overflow-hidden border-b-[3px] border-lime/30 py-2">
        <div class="marquee-track flex w-max gap-10 font-mono text-xs tracking-[0.24em] uppercase">
          {
            [...projects, ...projects].map((project) => (
              <span>{project.description}</span>
            ))
          }
        </div>
      </div>
      <div class="flex flex-col gap-2 px-4 py-3 font-mono text-xs sm:flex-row sm:items-center sm:justify-between">
        <a href="https://beian.miit.gov.cn/" target="_blank" class="hover:bg-lime hover:text-ink">
          鄂ICP备2023022007号
        </a>
        <span>©2026 代码笔记 / 独立开发老杨</span>
      </div>
    </footer>
  </section>
</BaseLayout>
